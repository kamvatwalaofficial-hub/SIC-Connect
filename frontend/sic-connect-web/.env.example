# Base URL of the SIC Connect API. Leave as /api to use the Vite dev proxy,
# or set an absolute URL (e.g. https://localhost:5001/api) to call the API directly.
VITE_API_BASE_URL=/api

# Target the dev proxy forwards /api to (used only when VITE_API_BASE_URL=/api).
VITE_API_PROXY_TARGET=http://localhost:5000
